# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file — it's already in .gitignore.

# Generate one with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-random-secret-key

# Must be "False" (as text) once this is live for real customers.
DJANGO_DEBUG=False

# Comma-separated list of domains this site is served from, e.g.:
# DJANGO_ALLOWED_HOSTS=roofline.co.za,www.roofline.co.za
DJANGO_ALLOWED_HOSTS=

# Comma-separated, full scheme+domain, needed for the admin login/CSRF to
# work over HTTPS in production, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://roofline.co.za,https://www.roofline.co.za
DJANGO_CSRF_TRUSTED_ORIGINS=

# Change the admin login path away from the default /admin/ so it isn't the
# first thing an automated bot tries, e.g. DJANGO_ADMIN_URL=shop-team-portal/
DJANGO_ADMIN_URL=admin/

# Set to False only if your host handles HTTPS redirection itself (most
# managed platforms already do, e.g. behind a load balancer).
DJANGO_SECURE_SSL_REDIRECT=True
